# docker-compose.yml로 띄운 로컬 PostgreSQL 기준.
DATABASE_URL="postgresql://babyfood:babyfood@localhost:55432/babyfood?schema=public"

# 정합화가 읽어 들이는 과거 식단의 범위(일). 이보다 오래된 식단은 이미 정산이 끝났다고 본다.
# 소급 미급여가 더 과거를 지목하면 그 날짜까지 자동으로 넓어진다.
LOOKBACK_DAYS=90

# /mcp가 답하는 호스트 이름. 쉼표로 나눈다. 비우면 localhost만 허용하므로,
# 배포할 때 실제 주소를 넣지 않으면 모든 요청이 403이 된다.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# 브라우저가 보내는 Origin 헤더의 허용 목록. Origin이 없는 요청은 언제나 통과한다.
# Claude Code 같은 비브라우저 클라이언트만 쓰면 기본값 그대로 둔다.
MCP_ALLOWED_ORIGINS=localhost,127.0.0.1

# 이 프로세스가 매분 정합화를 도는지. 비우면 true다. false로 두면 자동 차감이 일어나지 않으므로
# 배포 환경에서는 끄지 않는다. 스크립트나 테스트처럼 스케줄러 없이 띄울 때만 false로 둔다.
SCHEDULER_ENABLED=true

# Slack 봇 토큰(xoxb-로 시작). 브리프와 후속 메시지를 chat.postMessage로 보낼 때 쓴다. 필수다.
# 없으면 서버도 pnpm member-token, pnpm slack-link도 뜨지 않는다. 설정이 한곳(src/config/env.ts)에서 읽히기 때문이다.
SLACK_BOT_TOKEN=

# Slack 앱의 Signing Secret. 버튼 응답(POST /slack/interactions)의 X-Slack-Signature를 검증할 때 쓴다. 필수다.
# Slack 앱 설정의 Basic Information > App Credentials에 있다. 틀리면 모든 버튼 탭이 401로 거부된다.
SLACK_SIGNING_SECRET=
